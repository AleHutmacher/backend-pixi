# API Key que valida los endpoints internos (header "x-api-key")
# Genera una nueva con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# URL pública del propio backend en Vercel (la usa el proxy para reenviar)
# Ejemplo: https://backend-pixi.vercel.app
BACKEND_URL=

# Origen del frontend permitido por CORS en el proxy
# Ejemplo: https://tu-usuario.github.io
CORS_ORIGIN=

# Puerto local del servidor (Vercel lo asigna automáticamente en producción)
PORT=3000

# Conexión a PostgreSQL (Prisma)
POSTGRES_PRISMA_URL=postgresql://usuario:contraseña@host:5432/nombre_bd?schema=public
POSTGRES_URL_NON_POOLING=postgresql://usuario:contraseña@host:5432/nombre_bd?schema=public
